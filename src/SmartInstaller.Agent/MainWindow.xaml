<Window x:Class="SmartInstaller.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartInstaller Agent"
        Height="720" Width="1220" MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold"
                           Text="SmartInstaller Agent" />
                <TextBlock Margin="0,6,0,0" Foreground="DimGray"
                           Text="Scan, detect, download, verify, and silently install application updates." />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Foreground="DimGray" Text="System architecture" />
                <TextBlock x:Name="ArchitectureText" Margin="0,4,0,0"
                           HorizontalAlignment="Right" FontSize="18"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ScanButton" MinWidth="140" Padding="18,10"
                    Click="ScanButton_Click"
                    Content="Scan applications" />

            <Button x:Name="CheckUpdatesButton" Grid.Column="1"
                    Margin="10,0,0,0" MinWidth="130" Padding="18,10"
                    Click="CheckUpdatesButton_Click"
                    Content="Check updates" IsEnabled="False" />

            <Button x:Name="DownloadSelectedButton" Grid.Column="2"
                    Margin="10,0,0,0" MinWidth="145" Padding="18,10"
                    Click="DownloadSelectedButton_Click"
                    Content="Download selected" IsEnabled="False" />

            <Button x:Name="InstallSelectedButton" Grid.Column="3"
                    Margin="10,0,0,0" MinWidth="130" Padding="18,10"
                    Click="InstallSelectedButton_Click"
                    Content="Install selected" IsEnabled="False" />

            <Button x:Name="CancelButton" Grid.Column="4"
                    Margin="10,0,0,0" MinWidth="90" Padding="18,10"
                    Click="CancelButton_Click"
                    Content="Cancel" IsEnabled="False" />

            <TextBox x:Name="SearchTextBox" Grid.Column="5"
                     Margin="20,0,20,0" Padding="10,8"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Filter by application name, publisher, or version" />

            <TextBlock x:Name="CountText" Grid.Column="6"
                       VerticalAlignment="Center" FontWeight="SemiBold"
                       Text="0 applications" />
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Installed applications">
                <DataGrid x:Name="ApplicationsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Sorting="ApplicationsGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2.2*"
                                            Binding="{Binding Name}"
                                            Header="Application" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Version}"
                                            Header="Version" />
                        <DataGridTextColumn Width="1.5*"
                                            Binding="{Binding Publisher}"
                                            Header="Publisher" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding InstallDate}"
                                            Header="Installed" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="UpdatesTab" Header="Updates (0)">
                <DataGrid x:Name="UpdatesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="55"
                            Binding="{Binding IsSelected, Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"
                            Header="Use" />

                        <DataGridTextColumn Width="1.8*"
                            IsReadOnly="True"
                            Binding="{Binding ApplicationName}"
                            Header="Application" />

                        <DataGridTextColumn Width="*"
                            IsReadOnly="True"
                            Binding="{Binding InstalledVersion}"
                            Header="Installed" />

                        <DataGridTextColumn Width="*"
                            IsReadOnly="True"
                            Binding="{Binding LatestVersion}"
                            Header="Latest" />

                        <DataGridTextColumn Width="1.55*"
                            IsReadOnly="True"
                            Binding="{Binding Status}"
                            Header="Status" />

                        <DataGridTemplateColumn Width="1.35*"
                                                Header="Progress"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <ProgressBar Height="16"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Percentage}" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Text="{Binding ProgressText}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
