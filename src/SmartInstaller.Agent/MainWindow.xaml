<Window x:Class="SmartInstaller.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartInstaller Agent"
        Height="650"
        Width="1050"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="SmartInstaller Agent" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="DimGray"
                           Text="Scan Windows for installed applications." />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right">
                <TextBlock Foreground="DimGray"
                           Text="System architecture" />
                <TextBlock x:Name="ArchitectureText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Right"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ScanButton"
                    MinWidth="140"
                    Padding="18,10"
                    Click="ScanButton_Click"
                    Content="Scan applications" />

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    MinWidth="90"
                    Padding="18,10"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    IsEnabled="False" />

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="2"
                     Margin="20,0,20,0"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Filter by application name, publisher, or version" />

            <TextBlock x:Name="CountText"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="0 applications" />
        </Grid>

        <DataGrid x:Name="ApplicationsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Sorting="ApplicationsGrid_Sorting">
            <DataGrid.Columns>
                <DataGridTextColumn Width="2.2*"
                                    Binding="{Binding Name}"
                                    Header="Application" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Version}"
                                    Header="Version" />
                <DataGridTextColumn Width="1.5*"
                                    Binding="{Binding Publisher}"
                                    Header="Publisher" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding InstallDate}"
                                    Header="Installed" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding RegistryView}"
                                    Header="Registry view" />
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
