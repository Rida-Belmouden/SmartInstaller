<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartInstaller</title>
    <script type="importmap"></script>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/SmartInstaller.Web.styles.css"
          asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="container-fluid site-nav">
        <a class="brand"
           asp-controller="Home"
           asp-action="Index">
            SmartInstaller
        </a>

        <nav>
            <a asp-controller="Home"
               asp-action="Index">Home</a>
            <a asp-controller="AdminCatalog"
               asp-action="Index">Catalog admin</a>
        </nav>
    </div>
</header>

<main class="container-fluid page-container">
    @RenderBody()
</main>

<footer class="site-footer">
    SmartInstaller · 2026
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
